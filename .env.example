# Railway PostgreSQL — public URL from Railway → Postgres → Connect → Public Network.
# The postgres-ssl image requires SSL, so keep ?sslmode=require on the end.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway?sslmode=require"

# Anthropic API key for the "Soulo" travel concierge chatbot.
ANTHROPIC_API_KEY="sk-ant-..."

# ── Email notifications (OPTIONAL) ─────────────────────────────────────────────
# Powers owner notifications for the Advertise and Submit-a-Spot forms.
# If RESEND_API_KEY is unset, submissions are still saved to the database
# (AdvertiseInquiry / Submission tables) — email is simply skipped.
#
# To enable: create a Resend account, verify the soulospotter.com domain, then set:
RESEND_API_KEY="re_..."
# Optional overrides (sensible defaults are used if omitted):
EMAIL_FROM="SouloSpotter <notifications@soulospotter.com>"
OWNER_EMAIL="hello@soulospotter.com"
