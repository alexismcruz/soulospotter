generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  code      String   @unique // ISO 3166-1 alpha-2
  region    Region
  flagEmoji String?
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  countryId   String
  country     Country  @relation(fields: [countryId], references: [id])
  region      Region
  description String?  @db.Text
  imageUrl    String?
  lat         Float?
  lng         Float?
  timezone    String?
  currency    String?  // e.g. "USD", "EUR"
  language    String?  // primary language spoken
  safetyScore Int?     // 1-10
  costLevel   CostLevel?
  spots       Spot[]
  tags        CityTag[]
  experiences Experience[]
  seoTitle    String?
  seoDesc     String?  @db.Text
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([region])
  @@index([published])
}

model Spot {
  id          String     @id @default(cuid())
  name        String
  slug        String
  cityId      String
  city        City       @relation(fields: [cityId], references: [id])
  category    SpotCategory
  description String?    @db.Text
  address     String?
  lat         Float?
  lng         Float?
  website     String?
  phone       String?
  googleMapsUrl String?
  imageUrl    String?
  priceRange  PriceRange?
  rating      Float?     // aggregated, 1-5
  tags        SpotTag[]
  affiliateLinks AffiliateLink[]
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([cityId, slug])
  @@index([cityId, category])
  @@index([published])
}

model AffiliateLink {
  id        String          @id @default(cuid())
  spotId    String?
  spot      Spot?           @relation(fields: [spotId], references: [id])
  provider  AffiliateProvider
  url       String
  label     String?         // e.g. "Book on Booking.com"
  createdAt DateTime        @default(now())
}

// Tags are free-form strings stored normalized
model CityTag {
  id     String @id @default(cuid())
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tag    String

  @@unique([cityId, tag])
  @@index([tag])
}

model SpotTag {
  id     String @id @default(cuid())
  spotId String
  spot   Spot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  tag    String

  @@unique([spotId, tag])
  @@index([tag])
}

enum Region {
  NORTH_AMERICA
  LATIN_AMERICA
  EUROPE
  MIDDLE_EAST_AFRICA
  ASIA
  OCEANIA
}

enum CostLevel {
  BUDGET
  MID_RANGE
  EXPENSIVE
}

enum PriceRange {
  FREE
  BUDGET     // < $10
  MID        // $10-30
  HIGH       // $30+
}

enum SpotCategory {
  ACCOMMODATION   // hostels, guesthouses
  CAFE            // work-friendly cafes
  COWORKING       // coworking spaces
  FOOD            // restaurants, street food
  WELLNESS        // spas, yoga, meditation
  COMMUNITY       // meetup spots, expat hubs
  NATURE          // parks, hikes, beaches
  CULTURE         // museums, temples, galleries
  NIGHTLIFE
  TRANSPORT       // airports, bus hubs
}

model Submission {
  id          String           @id @default(cuid())
  // Submission type
  type        SubmissionType   @default(NEW)
  spotId      String?          // For corrections: reference to existing spot
  // Spot info
  spotName    String
  category    SpotCategory
  description String           @db.Text
  address     String
  website     String?
  imageUrl    String?          // user-provided photo URL
  // Location
  cityName    String           // free-text — we match to a City later
  countryName String
  // Submitter
  submitterName  String
  submitterEmail String
  // Status
  status      SubmissionStatus @default(PENDING)
  reviewNote  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model AdvertiseInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  business  String
  city      String
  tier      String   // "featured" | "spotlight" | "homepage"
  message   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionType {
  NEW          // New venue listing
  CORRECTION   // Update to existing venue (photo, hours, etc)
}

enum AffiliateProvider {
  BOOKING_COM
  HOSTELWORLD
  AIRBNB
  SAFETYWING
  WORLD_NOMADS
  AIRALO
  GETYOURGUIDE
  VIATOR
  OTHER
}

// ─── EXPERIENCES MARKETPLACE ───────────────────────────────────

model ExperienceOrganizer {
  id          String        @id @default(cuid())
  name        String
  email       String        @unique
  experiences Experience[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Experience {
  id            String              @id @default(cuid())
  slug          String              @unique
  name          String
  cityId        String
  city          City                @relation(fields: [cityId], references: [id])
  category      ExperienceCategory
  description   String              @db.Text
  price         Float               // per person
  groupSizeMin  Int
  groupSizeMax  Int
  duration      String              // "2 hours", "Full day", etc
  frequency     String              // one-time, daily, weekly, monthly, seasonal
  bookingUrl    String
  photoUrl      String?             // Cloudinary or Unsplash URL
  organizerId   String
  organizer     ExperienceOrganizer @relation(fields: [organizerId], references: [id])
  isFeatured    Boolean             @default(false)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([cityId])
  @@index([category])
  @@index([isFeatured])
  @@index([isActive])
}

model ExperienceSubmission {
  id              String                   @id @default(cuid())
  name            String
  city            String                   // city slug
  category        String                   // experience category
  description     String                   @db.Text
  price           Float
  groupSizeMin    Int
  groupSizeMax    Int
  duration        String
  frequency       String
  bookingUrl      String
  photoUrl        String?
  organizerName   String
  organizerEmail  String                   @unique
  package         String                   // "basic" or "featured"
  notes           String?                  @db.Text
  status          ExperienceSubmissionStatus @default(PENDING)
  reviewNote      String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum ExperienceCategory {
  OUTDOOR_ADVENTURE
  FOOD_DRINK
  ARTS_CULTURE
  WELLNESS_MINDFULNESS
  NIGHTLIFE_SOCIAL
  DAY_TRIPS
  PHOTOGRAPHY_WALKS
  FITNESS_SPORTS
}

enum ExperienceSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
